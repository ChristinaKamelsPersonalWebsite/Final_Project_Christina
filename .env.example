# ── Agent System A ─────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
MCP_SERVER_URL=http://mcp-server:8002
AGENT_B_URL=http://agent-system-b:8001
HTTP_TIMEOUT_SECONDS=60

# ── Agent System B ─────────────────────────────────────────────────────────────
OLLAMA_URL_B=http://ollama:11434
QDRANT_URL_B=http://qdrant:6333
NUTRITION_COLLECTION=nutrition_guides
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:1.5b

# ── MCP Server ─────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8002
